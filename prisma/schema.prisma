// Prisma schema — internship aggregator
// Source of truth for the data model: finalized_decisions/schema.md (Decision 5).
// Rationale for individual fields lives in DECISIONS.md 5/6/7 — don't duplicate it here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Source {
  greenhouse
  lever
  ashby
  other
}

enum EmploymentType {
  full_time
  part_time
  intern
  contract
  temporary
}

enum WorkplaceType {
  onsite
  remote
  hybrid
}

enum CompInterval {
  hourly
  monthly
  yearly
  one_time
}

enum CitizenshipStatus {
  us_citizen_required
  no_sponsorship
  sponsorship_available
  unknown
}

// Our CS-hub classification of the opportunity kind (Decision 10). Distinct from
// employment_type (the raw ATS value); overlap on intern/part_time is intentional —
// employment_type = "what the ATS said", opportunity_type = "what we classified it as".
enum OpportunityType {
  internship
  co_op
  fellowship
  new_grad
  research
  part_time
}

model Listing {
  // Identity / provenance
  id               Int    @id @default(autoincrement())
  source           Source
  sourceExternalId String @map("source_external_id")

  // Content
  company           String
  title             String
  descriptionHtml   String             @map("description_html")
  descriptionPlain  String             @map("description_plain")
  location          String?
  department        String?
  employmentType    EmploymentType?    @map("employment_type")
  workplaceType     WorkplaceType?     @map("workplace_type")
  compMin           Decimal?           @map("comp_min") @db.Decimal(12, 2)
  compMax           Decimal?           @map("comp_max") @db.Decimal(12, 2)
  compCurrency      String?            @map("comp_currency")
  compInterval      CompInterval?      @map("comp_interval")
  gradYearMin       Int?               @map("grad_year_min")
  gradYearMax       Int?               @map("grad_year_max")
  citizenshipStatus CitizenshipStatus? @map("citizenship_status")
  opportunityType   OpportunityType?   @map("opportunity_type")

  // Dates / lifecycle
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(6)
  applicationDeadline DateTime? @map("application_deadline") @db.Timestamptz(6)
  firstSeenAt         DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  isListed            Boolean   @default(true) @map("is_listed")

  // Links
  url String

  // Natural key: identifies "same listing across refreshes" (upsert target).
  // Distinct from `id`; cross-source dedup is a separate layer (not this constraint).
  @@unique([source, sourceExternalId])
  @@map("listings")
}

// A discovered ATS board to crawl (Decision 11). Populated by the Common Crawl discovery
// job (slug-only: discovery writes just `source` + `token`), then read by the daily
// refresh. Deliberately does NOT store company — discovery is slug-only; the refresh path
// derives company from the job payload (see DECISIONS.md Decision 11 open follow-up).
model CrawlTarget {
  id     Int    @id @default(autoincrement())
  source Source
  token  String // the board slug (e.g. "gitlab"); the only field discovery derives from CC

  // Soft-deactivation (Decision 11): a target not seen in discovery for ~2-3 months is
  // flipped to false rather than deleted. The pruning threshold/logic itself is
  // FIRST-DRAFT-MINE (freshness-adjacent) — not implemented here; this column just stores
  // the timestamp that logic reads.
  isActive              Boolean  @default(true) @map("is_active")
  lastSeenInDiscoveryAt DateTime @default(now()) @map("last_seen_in_discovery_at") @db.Timestamptz(6)

  // Crawl health, written by the daily REFRESH (not discovery); nullable until first refresh.
  lastCrawledAt DateTime? @map("last_crawled_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")

  // Natural key: discovery re-runs upsert on (source, token) instead of duplicating.
  @@unique([source, token])
  @@map("crawl_targets")
}
