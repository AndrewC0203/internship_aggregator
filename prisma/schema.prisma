// Prisma schema — internship aggregator
// Source of truth for the data model: finalized_decisions/schema.md (Decision 5).
// Rationale for individual fields lives in DECISIONS.md 5/6/7 — don't duplicate it here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Source {
  greenhouse
  lever
  ashby
  other
}

enum EmploymentType {
  full_time
  part_time
  intern
  contract
  temporary
}

enum WorkplaceType {
  onsite
  remote
  hybrid
}

enum CompInterval {
  hourly
  monthly
  yearly
  one_time
}

enum CitizenshipStatus {
  us_citizen_required
  no_sponsorship
  sponsorship_available
  unknown
}

// Our CS-hub classification of the opportunity kind (Decision 10). Distinct from
// employment_type (the raw ATS value); overlap on intern/part_time is intentional —
// employment_type = "what the ATS said", opportunity_type = "what we classified it as".
enum OpportunityType {
  internship
  co_op
  fellowship
  new_grad
  research
  part_time
}

// Primary CS subfield of the role (Decision 16). Single-label on purpose: a role that
// straddles ("ML SWE") gets its dominant field, because this drives one-click UI filters —
// multi-label is a v2 question. Null = kept before this field existed, or the classifier
// abstained; `other` = confidently CS-adjacent but none of the named buckets.
enum CsField {
  swe
  ml_ai
  data
  quant
  security
  hardware_embedded
  devops_infra
  it
  product
  other
}

model Listing {
  // Identity / provenance
  id               Int    @id @default(autoincrement())
  source           Source
  sourceExternalId String @map("source_external_id")

  // Content
  company           String
  title             String
  descriptionHtml   String             @map("description_html")
  descriptionPlain  String             @map("description_plain")
  location          String?
  department        String?
  employmentType    EmploymentType?    @map("employment_type")
  workplaceType     WorkplaceType?     @map("workplace_type")
  compMin           Decimal?           @map("comp_min") @db.Decimal(12, 2)
  compMax           Decimal?           @map("comp_max") @db.Decimal(12, 2)
  compCurrency      String?            @map("comp_currency")
  compInterval      CompInterval?      @map("comp_interval")
  // Derived from gradDateMin/Max via the class-year rule (Decision 17): Aug–Dec graduation
  // months roll into the FOLLOWING class year. These stay because the filter/API reads years;
  // the raw stated months below are the source of truth they're recomputed from.
  gradYearMin       Int?               @map("grad_year_min")
  gradYearMax       Int?               @map("grad_year_max")
  // The graduation window as the posting literally states it — "YYYY-MM", or "YYYY" when no
  // month is given (Decision 17). Facts, not policy: extraction copies these verbatim, and
  // the class-year conversion happens in code, so a change to that rule re-derives the year
  // columns without re-running the model.
  gradDateMin       String?            @map("grad_date_min")
  gradDateMax       String?            @map("grad_date_max")
  citizenshipStatus CitizenshipStatus? @map("citizenship_status")
  opportunityType   OpportunityType?   @map("opportunity_type")
  csField           CsField?           @map("cs_field")

  // Dates / lifecycle
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(6)
  applicationDeadline DateTime? @map("application_deadline") @db.Timestamptz(6)
  firstSeenAt         DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  isListed            Boolean   @default(true) @map("is_listed")

  // Links
  url String

  // Derived location facets (Decision 19): ISO-3166 alpha-2 country codes + US state codes
  // resolved from the raw `location` string by the deterministic parser in
  // src/pipeline/stages/location.ts. ARRAYS because measured data has single listings spanning
  // several states and countries ("London, UK; ...; San Francisco, CA" —
  // research/location-shape-analysis.md). Empty arrays = unresolved/unknown, never a guess.
  // `location` itself stays raw: the Decision 15 dedup key matches on it exactly.
  locCountries String[] @default([]) @map("loc_countries")
  locUsStates  String[] @default([]) @map("loc_us_states")

  // Dedup linking (Decision 9 storage mechanism, Decision 15 key + representation). A JSON
  // array of {source, sourceExternalId} objects — every listing suppressed as a duplicate of
  // THIS row. Never hard-deleted (Decision 9): a duplicate's key lives here instead of getting
  // its own row. JSONB over a join table because the array is small (single digits per
  // canonical, observed max 6), is only ever read/written as a whole by dedup.ts, and never
  // needs its own indexed queries — a second table would be pure ceremony for that access
  // pattern. Default empty array so every row (not just ones with duplicates) has a value.
  duplicateKeys Json @default("[]") @map("duplicate_keys")

  // Natural key: identifies "same listing across refreshes" (upsert target).
  // Distinct from `id`; cross-source dedup is a separate layer (not this constraint).
  @@unique([source, sourceExternalId])
  // Supports dedup.ts's lookup: "is there an active listing with this (company, title,
  // location)?" Added now because dedup runs on every refresh, not deferred as premature.
  @@index([company, title, location])
  @@map("listings")
}

// A discovered ATS board to crawl (Decision 11). Populated by the Common Crawl discovery
// job (slug-only: discovery writes just `source` + `token`), then read by the daily
// refresh. Deliberately does NOT store company — discovery is slug-only; the refresh path
// derives company from the job payload (see DECISIONS.md Decision 11 open follow-up).
model CrawlTarget {
  id     Int    @id @default(autoincrement())
  source Source
  token  String // the board slug (e.g. "gitlab"); the only field discovery derives from CC

  // Soft-deactivation (Decision 11): a target not seen in discovery for ~2-3 months is
  // flipped to false rather than deleted. The pruning threshold/logic itself is
  // FIRST-DRAFT-MINE (freshness-adjacent) — not implemented here; this column just stores
  // the timestamp that logic reads.
  isActive              Boolean  @default(true) @map("is_active")
  lastSeenInDiscoveryAt DateTime @default(now()) @map("last_seen_in_discovery_at") @db.Timestamptz(6)

  // Crawl health, written by the daily REFRESH (not discovery); nullable until first refresh.
  lastCrawledAt DateTime? @map("last_crawled_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")

  // Natural key: discovery re-runs upsert on (source, token) instead of duplicating.
  @@unique([source, token])
  @@map("crawl_targets")
}

// Skip-memory for REJECTED listings (Decision 12; amends Decision 10). Holds only the
// natural key of listings the classifier dropped, so the daily refresh's partition step can
// skip re-classifying them instead of paying the AI cost on every run. Keeps are NOT stored
// here — their presence in `listings` is their skip-memory.
//
// KEY-ONLY by decision: no description hash, so a reject is never re-evaluated even if its
// posting text is later edited into scope (accepted tradeoff for simplicity). Composite PK
// (source, source_external_id) is the whole row — no surrogate id, deliberately narrow.
// last_seen_at is bookkeeping for a future prune of stale reject keys (that pruning policy is
// FIRST-DRAFT-MINE / freshness-adjacent — not implemented here).
model SeenListing {
  source           Source
  sourceExternalId String   @map("source_external_id")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@id([source, sourceExternalId])
  @@map("seen_listings")
}
