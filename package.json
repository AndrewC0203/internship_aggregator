{
  "name": "internship_aggregator",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "postbuild": "cp -r src/server/public dist/server/public",
    "postinstall": "prisma generate",
    "start": "node dist/server/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "discover": "tsx src/discovery/run.ts",
    "refresh": "tsx src/refresh.ts",
    "refresh:nightly": "bash scripts/nightly-refresh.sh --now",
    "reclassify": "tsx src/reclassify.ts",
    "enrich": "tsx src/enrich.ts",
    "eval:recommend": "tsx src/eval-recommend.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "serve": "tsx src/server/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewC0203/internship_aggregator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AndrewC0203/internship_aggregator/issues"
  },
  "homepage": "https://github.com/AndrewC0203/internship_aggregator#readme",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.1"
  }
}
